# Server-side Supabase project credentials. Never expose the service-role key in frontend code.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SECRET_SERVICE_ROLE_KEY

# Local development only; Render supplies these as environment variables
NODE_ENV=development
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# Set only for first-run production bootstrap (Render environment variables).
#ADMIN_EMAIL=
#ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters-long
